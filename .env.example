# Configuration names and constraints. Keep real values in your local environment or secret store.
# APP_ENV: development, test, or production (defaults to development).
# DATABASE_URL: local SQLite URL beginning with sqlite:/// (defaults to sqlite:///./bookmarks.db).
# JWT_SECRET: production requires a unique, non-placeholder secret of at least 32 characters.
# ACCESS_TOKEN_TTL_MINUTES: 1-1440 (defaults to 30).
# TOP_TAGS_LIMIT: 1-100 (defaults to 5).
# STATS_REFRESH_ENABLED: true or false (defaults to true).
# STATS_REFRESH_INTERVAL_SECONDS: 1-3600 (defaults to 10).
# STATS_STALE_AFTER_SECONDS: at least STATS_REFRESH_INTERVAL_SECONDS (defaults to 30).
# STATS_INITIAL_REFRESH_TIMEOUT_SECONDS: 0-60 (defaults to 5).
# STATS_SHUTDOWN_TIMEOUT_SECONDS: 1-60 (defaults to 5).
# STATS_FULL_RECONCILIATION_SECONDS: at least STATS_REFRESH_INTERVAL_SECONDS (defaults to 300).
# STATS_EVENT_QUEUE_CAPACITY: 1-1000000 (defaults to 1000).
# STATS_DIRTY_MAX_AGE_SECONDS: at least STATS_REFRESH_INTERVAL_SECONDS (defaults to 60).
# STATS_DIRTY_MAX_COUNT: 1-1000000 (defaults to 1000).
# APP_WORKER_COUNT: must be 1 while STATS_REFRESH_ENABLED is true (defaults to 1).
# RATE_LIMIT_ENABLED: true or false; must be true in production (defaults to true).
# RATE_LIMIT_AUTH_REQUESTS: 1-10000 (defaults to 10).
# RATE_LIMIT_AUTH_WINDOW_SECONDS: 1-3600 (defaults to 60).
# RATE_LIMIT_BOOKMARK_REQUESTS: 1-10000 (defaults to 120).
# RATE_LIMIT_BOOKMARK_WINDOW_SECONDS: 1-3600 (defaults to 60).
# RATE_LIMIT_MAX_KEYS: 1-100000 (defaults to 10000 per local policy bucket).
# RATE_LIMIT_IDLE_TTL_SECONDS: 1-86400 and at least each rate-limit window (defaults to 300).
# CURSOR_TTL_SECONDS: 60-3600 for authenticated bookmark cursor tokens (defaults to 900).
# SQLITE_BUSY_TIMEOUT_MILLISECONDS: 1-60000 (defaults to 5000).
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, or CRITICAL (defaults to INFO).
